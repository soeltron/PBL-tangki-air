APP_NAME="Monitoring Tandon"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_GENERATED_32_BYTE_KEY
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tandon
DB_USERNAME=tandon
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=REPLACE_WITH_AN_MQTT_USERNAME
MQTT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MQTT_PASSWORD

TZ=Asia/Jakarta
NGROK_AUTHTOKEN=REPLACE_WITH_YOUR_NGROK_AUTHTOKEN